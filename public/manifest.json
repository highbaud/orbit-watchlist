{
  "manifest_version": 3,
  "name": "Orbit Watchlist",
  "version": "0.1.0",
  "description": "Private, local crypto watchlists for your Chrome side panel.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open Orbit Watchlist",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "sidePanel"],
  "optional_host_permissions": [
    "https://api.coingecko.com/*",
    "https://pro-api.coingecko.com/*",
    "https://pro-api.coinmarketcap.com/*"
  ]
}
